// Project settings for Zed.
//
// Requires the "gdscript" extension (install it via the extensions panel, or
// add it to auto_install_extensions in your user settings; Zed ignores that
// key at project level). It proxies to the language server built into the
// Godot editor (127.0.0.1:6005), so the editor must be running for
// completions, diagnostics and go-to-definition:
//   mise run editor
{
  "languages": {
    "GDScript": {
      "hard_tabs": true,
      "tab_size": 4,
      "format_on_save": "off",
      "remove_trailing_whitespace_on_save": true,
      "ensure_final_newline_on_save": true
    }
  },
  "file_types": {
    "GDScript": ["gd"]
  }
}
